{
  "name": "takomo",
  "version": "10.0.0-alpha.0",
  "description": "Organize, configure and deploy CloudFormation stacks.",
  "keywords": [
    "aws",
    "cloudformation",
    "cfn",
    "deploy",
    "cli",
    "cloudformation templates",
    "cloudformation stacks",
    "cloudformation deployment"
  ],
  "homepage": "https://takomo.io",
  "bugs": "https://github.com/takomo-io/takomo/issues",
  "repository": {
    "type": "git",
    "url": "git@github.com:takomo-io/takomo.git"
  },
  "license": "MIT",
  "author": "henri@takomo.io",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "takomo": "bin/tkm.mjs",
    "tkm": "bin/tkm.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --selectProjects test --maxWorkers=2 --ci --verbose",
    "integration-test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --selectProjects integration-test --maxWorkers=5 --ci --verbose",
    "single-integration-test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --selectProjects integration-test --ci --verbose -i",
    "single-test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --ci --verbose -i",
    "clean": "rm -f package-lock.json && rm -rf node_modules && rm -rf dist",
    "clean-build": "npm run clean && npm install && npm run build",
    "depcheck": "depcheck",
    "check-updates": "npx ncu -i --cooldown 10d"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --quiet --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        0,
        "always",
        160
      ],
      "body-max-line-length": [
        0,
        "always",
        160
      ],
      "footer-max-line-length": [
        0,
        "always",
        160
      ]
    }
  },
  "devDependencies": {
    "ts-jest": "29.4.12",
    "@jest/globals": "30.4.1",
    "@aws-sdk/client-ec2": "3.1090.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@jest/console": "30.4.1",
    "@takomo/test-custom-helper-lowercase": "0.0.1",
    "@takomo/test-custom-helper-uppercase": "0.0.1",
    "@takomo/test-custom-resolver-code": "0.0.1",
    "@takomo/test-custom-resolver-name": "0.0.1",
    "@types/folder-hash": "4.0.4",
    "@types/jest": "30.0.0",
    "@types/jmespath": "0.15.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.1.0",
    "@types/ramda": "0.31.1",
    "@types/semver": "7.7.1",
    "@types/yargs": "17.0.35",
    "@types/ejs": "3.1.5",
    "@types/lodash": "4.17.24",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "depcheck": "1.4.7",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "@eslint/js": "10.0.1",
    "@eslint/eslintrc": "3.3.6",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-node": "30.4.1",
    "jest-mock-extended": "4.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "lint-staged": "17.2.0",
    "testenv-recycler": "0.0.16",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "semantic-release": "25.0.8",
    "npm-check-updates": "23.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1090.0",
    "@aws-sdk/client-cloudtrail": "3.1090.0",
    "@aws-sdk/client-organizations": "3.1090.0",
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/client-secrets-manager": "3.1090.0",
    "@aws-sdk/client-ssm": "3.1090.0",
    "@aws-sdk/client-sts": "3.1090.0",
    "@aws-sdk/credential-providers": "3.1090.0",
    "@smithy/util-retry": "4.5.10",
    "@smithy/node-http-handler": "4.9.7",
    "@aws-sdk/types": "3.974.2",
    "chalk": "5.6.2",
    "cockatiel": "4.0.0",
    "date-and-time": "4.5.1",
    "diff": "9.0.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "easy-table": "1.2.0",
    "folder-hash": "4.1.3",
    "handlebars": "4.7.9",
    "@inquirer/prompts": "8.5.2",
    "jmespath": "0.16.0",
    "joi": "18.2.3",
    "js-yaml": "4.3.0",
    "json-stable-stringify": "1.3.0",
    "neverthrow": "8.2.0",
    "p-queue": "9.3.1",
    "pretty-ms": "9.3.0",
    "ramda": "0.32.0",
    "readdirp": "5.0.0",
    "semver": "7.8.5",
    "source-map-support": "0.5.21",
    "ts-dedent": "2.3.0",
    "uuid": "14.0.1",
    "yargs": "18.0.0",
    "esbuild": "0.28.1",
    "ejs": "6.0.1",
    "lodash": "4.18.1"
  }
}
